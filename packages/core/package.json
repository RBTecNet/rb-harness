{
  "name": "@rb-harness/core",
  "version": "0.1.0",
  "description": "Deterministic contracts and artifact discovery for RB Harness",
  "type": "module",
  "bin": {
    "rb-harness": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
