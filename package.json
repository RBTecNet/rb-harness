{
  "name": "rb-harness",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run build && npm run typecheck && npm test && bash scripts/test-bash-compat.sh && node scripts/check-plugin.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
