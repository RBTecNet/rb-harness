{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rbtecnologia.net.br/contracts/rb-operational-v1.schema.json",
  "title": "RB Operational Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "scenarios"],
  "properties": {
    "contract": { "const": "rb-operational/v1" },
    "cleanRoom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inherit": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "uniqueItems": true },
        "set": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "cwd": { "type": "string", "minLength": 1 },
        "env": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exitCode": { "type": "integer" },
        "stdoutIncludes": { "type": "array", "items": { "type": "string" } },
        "stderrIncludes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "probe": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "http" }, "url": { "type": "string", "minLength": 1 },
            "method": { "type": "string" }, "body": { "type": "string" }, "status": { "type": "integer" },
            "headers": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
            "bodyIncludes": { "type": "array", "items": { "type": "string" } }, "timeoutSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "host", "port"],
          "properties": {
            "kind": { "const": "tcp" }, "host": { "type": "string", "minLength": 1 },
            "port": { "type": ["integer", "string"] }, "timeoutSeconds": { "type": "integer", "minimum": 1 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "file" }, "path": { "type": "string", "minLength": 1 },
            "exists": { "type": "boolean" }, "includes": { "type": "string" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "includes"],
          "properties": { "kind": { "const": "stdout" }, "includes": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "step": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "command"],
          "properties": {
            "id": { "type": "string", "minLength": 1 }, "kind": { "const": "command" },
            "command": { "$ref": "#/$defs/command" }, "timeoutSeconds": { "type": "integer", "minimum": 0 },
            "expect": { "$ref": "#/$defs/expect" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["id", "kind", "command", "ready"],
          "properties": {
            "id": { "type": "string", "minLength": 1 }, "kind": { "const": "process" },
            "command": { "$ref": "#/$defs/command" }, "ready": { "$ref": "#/$defs/probe" },
            "readyTimeoutSeconds": { "type": "integer", "minimum": 1 },
            "checks": { "type": "array", "items": { "$ref": "#/$defs/probe" } }
          }
        },
        {
          "allOf": [
            { "$ref": "#/$defs/probe" },
            { "type": "object", "required": ["id"], "properties": { "id": { "type": "string", "minLength": 1 } } }
          ]
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "platforms": { "type": "array", "items": { "enum": ["linux", "darwin", "win32"] }, "uniqueItems": true },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    }
  }
}
