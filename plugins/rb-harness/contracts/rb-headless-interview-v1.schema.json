{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rbtecnologia.net.br/contracts/rb-headless-interview-v1.schema.json",
  "title": "RB Headless Interview v1",
  "oneOf": [
    { "$ref": "#/$defs/start" },
    { "$ref": "#/$defs/answerRequest" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "questionId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sequence": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "initRequest": { "$ref": "rb-headless-init-v1.schema.json#/$defs/request" },
    "start": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "kind", "requestId", "captureHash", "initRequest", "cursor"],
      "properties": {
        "contract": { "const": "rb-headless-interview/v1" },
        "kind": { "const": "interview_start" },
        "requestId": { "$ref": "#/$defs/id" },
        "captureHash": { "$ref": "#/$defs/sha256" },
        "initRequest": { "$ref": "#/$defs/initRequest" },
        "cursor": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "answerRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "kind", "requestId", "interviewId", "sequence", "questionId", "answer", "idempotencyKey", "cursor"],
      "properties": {
        "contract": { "const": "rb-headless-interview/v1" },
        "kind": { "const": "answer" },
        "requestId": { "$ref": "#/$defs/id" },
        "interviewId": { "$ref": "#/$defs/id" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "questionId": { "$ref": "#/$defs/questionId" },
        "answer": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "idempotencyKey": { "$ref": "#/$defs/id" },
        "cursor": { "$ref": "#/$defs/sha256" }
      }
    },
    "option": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "recommended"],
      "properties": {
        "id": { "$ref": "#/$defs/questionId" },
        "label": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "recommended": { "type": "boolean" }
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sequence", "questionId", "header", "reason", "question", "type", "options", "allowsFreeText", "draftSchemaHash"],
      "properties": {
        "kind": { "const": "question" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "questionId": { "$ref": "#/$defs/questionId" },
        "header": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "type": { "enum": ["text", "single-choice", "confirm"] },
        "options": {
          "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/option" },
          "contains": { "type": "object", "required": ["recommended"], "properties": { "recommended": { "const": true } } },
          "minContains": 0, "maxContains": 1
        },
        "allowsFreeText": { "type": "boolean" },
        "draftSchemaHash": { "$ref": "#/$defs/sha256" },
        "answerFor": { "$ref": "#/$defs/questionId" }
      },
      "allOf": [{
        "if": { "properties": { "type": { "const": "single-choice" } }, "required": ["type"] },
        "then": { "properties": { "options": { "minItems": 2 } } },
        "else": { "properties": { "options": { "maxItems": 0 } } }
      }]
    },
    "answerResult": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sequence", "questionId", "disposition"],
      "properties": {
        "kind": { "const": "answer_result" },
        "sequence": { "$ref": "#/$defs/sequence" },
        "questionId": { "$ref": "#/$defs/questionId" },
        "disposition": { "enum": ["accepted", "partial", "ambiguous", "deferred", "contradicted"] },
        "normalizedDecision": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "remainingUncertainty": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "followUpQuestionId": { "$ref": "#/$defs/questionId" }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "accepted" } }, "required": ["disposition"] },
          "then": { "required": ["normalizedDecision"], "not": { "anyOf": [{ "required": ["remainingUncertainty"] }, { "required": ["followUpQuestionId"] }] } },
          "else": { "not": { "required": ["normalizedDecision"] } }
        },
        {
          "if": { "properties": { "disposition": { "enum": ["partial", "ambiguous", "contradicted"] } }, "required": ["disposition"] },
          "then": { "required": ["remainingUncertainty", "followUpQuestionId"] }
        }
      ]
    },
    "acceptedAnswer": {
      "type": "object", "additionalProperties": false,
      "required": ["questionId", "question", "answer", "disposition"],
      "properties": {
        "questionId": { "$ref": "#/$defs/questionId" },
        "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "answer": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "disposition": { "const": "accepted" }
      }
    },
    "complete": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "acceptedAnswers", "transcriptHash"],
      "properties": {
        "kind": { "const": "interview_complete" },
        "acceptedAnswers": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/acceptedAnswer" } },
        "transcriptHash": { "$ref": "#/$defs/sha256" }
      }
    },
    "failed": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "diagnosticCode", "retryable"],
      "properties": {
        "kind": { "const": "interview_failed" },
        "diagnosticCode": { "type": "string", "minLength": 1, "maxLength": 200 },
        "retryable": { "type": "boolean" }
      }
    },
    "event": { "oneOf": [{ "$ref": "#/$defs/question" }, { "$ref": "#/$defs/answerResult" }, { "$ref": "#/$defs/complete" }, { "$ref": "#/$defs/failed" }] },
    "harness": {
      "type": "object", "additionalProperties": false, "required": ["version", "sha256"],
      "properties": { "version": { "type": "string", "minLength": 1, "maxLength": 100 }, "sha256": { "$ref": "#/$defs/sha256" } }
    },
    "adapter": {
      "type": "object", "additionalProperties": false, "required": ["id", "version", "provider", "model"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "provider": { "type": "string", "minLength": 1, "maxLength": 120 }, "model": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["contract", "kind", "requestId", "requestHash", "status", "interviewId", "cursor", "events", "harness", "adapter", "startedAt", "finishedAt"],
      "properties": {
        "contract": { "const": "rb-headless-interview/v1" }, "kind": { "const": "response" },
        "requestId": { "$ref": "#/$defs/id" }, "requestHash": { "$ref": "#/$defs/sha256" },
        "status": { "enum": ["active", "complete", "invalid", "failed"] },
        "interviewId": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "cursor": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "events": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/event" } },
        "harness": { "$ref": "#/$defs/harness" }, "adapter": { "$ref": "#/$defs/adapter" },
        "diagnosticCode": { "type": "string", "maxLength": 200 },
        "startedAt": { "type": "string", "format": "date-time" }, "finishedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
