{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rbtecnologia.net.br/contracts/rb-responsive-inventory-v1.schema.json",
  "title": "RB Responsive Inventory Contract v1",
  "type": "object",
  "required": ["contract", "reviewId", "depth", "targetRevision", "applicability"],
  "properties": {
    "contract": { "const": "rb-responsive-inventory/v1" },
    "reviewId": { "type": "string", "minLength": 1 },
    "depth": { "enum": ["quick", "balanced", "deep"] },
    "targetRevision": { "type": "string", "minLength": 1 },
    "applicability": { "enum": ["APPLICABLE", "NOT_APPLICABLE"] },
    "reason": { "type": "string", "minLength": 1 },
    "mechanisms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "purpose", "limitations"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "uiFiles": { "$ref": "#/$defs/fileAccounting" },
    "layoutCandidates": { "$ref": "#/$defs/candidateAccounting" },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "applicability": { "const": "NOT_APPLICABLE" } } },
      "then": { "required": ["reason"] },
      "else": { "required": ["mechanisms", "commands", "uiFiles", "layoutCandidates"] }
    }
  ],
  "$defs": {
    "accountingCounts": {
      "type": "object",
      "required": ["discovered", "analyzed", "excluded", "unresolved", "entries"],
      "properties": {
        "discovered": { "type": "integer", "minimum": 0 },
        "analyzed": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "unresolved": { "type": "integer", "minimum": 0 }
      }
    },
    "fileAccounting": {
      "allOf": [
        { "$ref": "#/$defs/accountingCounts" },
        {
          "type": "object",
          "properties": {
            "entries": { "type": "array", "items": { "$ref": "#/$defs/fileEntry" } }
          }
        }
      ]
    },
    "fileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "disposition", "candidateIds"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["ANALYZED", "EXCLUDED", "UNKNOWN"] },
        "candidateIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "candidateAccounting": {
      "allOf": [
        { "$ref": "#/$defs/accountingCounts" },
        {
          "type": "object",
          "properties": {
            "entries": { "type": "array", "items": { "$ref": "#/$defs/candidate" } }
          }
        }
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "role"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "layoutState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parentConstraint", "childRequirement", "relationship", "assessment"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "parentConstraint": { "type": "string", "minLength": 1 },
        "childRequirement": { "type": "string", "minLength": 1 },
        "relationship": { "type": "string", "minLength": 1 },
        "assessment": { "enum": ["COMPATIBLE", "INCOMPATIBLE", "UNKNOWN"] }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "mechanism", "disposition", "sourceRefs", "invariantsChecked", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^RC-[A-Z0-9][A-Z0-9-]*$" },
        "path": { "type": "string", "minLength": 1 },
        "mechanism": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["CONFIRMED_DEFECT", "LIKELY_DEFECT", "ANALYZED_SAFE", "FALSE_POSITIVE_RISK", "EXCLUDED", "UNKNOWN"] },
        "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceRef" } },
        "invariantsChecked": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "layoutStates": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/layoutState" } },
        "rationale": { "type": "string", "minLength": 1 },
        "findingIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
