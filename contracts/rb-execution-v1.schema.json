{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rb-harness.dev/contracts/rb-execution-v1.schema.json",
  "title": "RB Execution v1 parsed representation",
  "type": "object",
  "required": ["contract", "artifactId", "title", "phases"],
  "properties": {
    "contract": { "const": "rb-execution/v1" },
    "artifactId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "id", "title", "goal", "dependsOn", "context", "tasks"]
      }
    }
  },
  "additionalProperties": false
}
